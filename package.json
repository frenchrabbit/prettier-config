{
  "name": "@frabbit/prettier-config",
  "version": "3.0.2",
  "type": "module",
  "description": "frabbit prettier config for prettier 3",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "release": "bumpp && npm publish"
  },
  "author": "hello@frabbit.ru",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frenchrabbit/prettier-config.git"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "prettier": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "bumpp": "^12.3.0",
    "prettier": "^3.9.10",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2"
  }
}
