{
  "name": "@frabbit/prettier-config",
  "version": "2.0.0",
  "type": "module",
  "description": "frabbit prettier config for prettier 3",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "release": "bumpp && npm publish"
  },
  "author": "hello@frabbit.ru",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frenchrabbit/prettier-config.git"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "prettier": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "bumpp": "^11.0.1",
    "prettier": "^3.8.2",
    "tsdown": "^0.16.0",
    "typescript": "^5.8.3"
  },
  "module": "./dist/index.mjs"
}
